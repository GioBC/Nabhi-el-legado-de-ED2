# Unity packages
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# PSB (Photoshop Big - Unity 2D Animation)
*.psb filter=lfs diff=lfs merge=lfs -text

# Unity Editor settings (text files - should NOT use LFS)
*.meta -filter -diff -merge text
*.mat -filter -diff -merge text
*.physicMaterial -filter -diff -merge text
*.physicsMaterial2D -filter -diff -merge text
*.shadergraph -filter -diff -merge text
*.lighting -filter -diff -merge text
*.giparams -filter -diff -merge text

# Scripts and text files (should NOT use LFS)
*.cs -filter -diff -merge text
*.js -filter -diff -merge text
*.boo -filter -diff -merge text
*.shader -filter -diff -merge text
*.compute -filter -diff -merge text
*.cginc -filter -diff -merge text
*.hlsl -filter -diff -merge text
*.glsl -filter -diff -merge text
*.md -filter -diff -merge text
*.txt -filter -diff -merge text
*.json -filter -diff -merge text
*.xml -filter -diff -merge text
*.yaml -filter -diff -merge text
*.yml -filter -diff -merge text

# Ensure line endings are normalized for text files
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.meta text eol=lf
*.md text eol=lf
*.json text eol=lf
